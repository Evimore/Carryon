[Unit]
Description=Carryon: check the backup is current, complete and restorable
Documentation=https://github.com/Evimore/carryon
Wants=network-online.target
After=network-online.target
ConditionPathExists=!/var/lib/carryon/restoring
OnFailure=carryon-notify@%n.service

[Service]
Type=oneshot
# carryon verify comes with roadmap task T13.
ExecStart=/usr/bin/carryon verify --deep
Nice=19
IOSchedulingClass=idle
CPUSchedulingPolicy=batch
