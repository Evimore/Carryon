[Unit]
Description=sysbackup: check the backup is current, complete and restorable
Wants=network-online.target
After=network-online.target
OnFailure=sysbackup-notify@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/sysbackup verify --deep
Environment=PYTHONUNBUFFERED=1
Nice=19
IOSchedulingClass=idle
