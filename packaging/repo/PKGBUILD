# Maintainer: Evimore <100224882+Evimore@users.noreply.github.com>
#
# The `carryon` package of Carryon's own pacman repository: the files of a release tarball, with
# nothing compiled. packaging/repo/build.sh fills in the version and checksums, and the "Release"
# workflow publishes it (docs/packaging.md, "The pacman repository").

pkgname=carryon
pkgver=0.0.0
pkgrel=1
pkgdesc='Back up what makes your Linux machine yours, and get it back on any fresh install'
arch=('x86_64' 'aarch64')
url='https://github.com/Evimore/carryon'
license=('GPL-3.0-or-later')
depends=('restic')
optdepends=('git: keep the history of the system record'
            'rclone: back up to cloud storage through rclone'
            'paru: reinstall AUR packages on restore'
            'yay: reinstall AUR packages on restore'
            'libnotify: desktop notifications when a backup fails'
            'polkit: back up, restore and settle suggestions from the desktop without sudo')
conflicts=('carryon-bin' 'carryon-git')
# The release binary is already stripped.
options=('!strip' '!debug')
# Empty on purpose: the package installs nothing under /etc, `carryon init` writes /etc/carryon.
backup=()
install=carryon.install
# The tarballs are next to this file: build.sh puts them there.
source_x86_64=("$pkgname-$pkgver-linux-x86_64.tar.gz")
source_aarch64=("$pkgname-$pkgver-linux-aarch64.tar.gz")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  # The tarball holds the tree `make install` lays out.
  cp -a --no-preserve=ownership "$pkgname-$pkgver-linux-$CARCH/usr" "$pkgdir/"
}
